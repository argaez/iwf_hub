<!DOCTYPE html>
<html>
<head>
  <title>IWF Hub</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f3f4f6;
      min-height: 100vh;
    }
    header {
      background: white;
      border-bottom: 1px solid #e5e7eb;
      padding: 16px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand {
      font-size: 18px;
      font-weight: 800;
      color: #15385E;
      letter-spacing: -0.3px;
    }
    .brand span { color: #EF6B35; font-size: 26px; font-weight: 900; }
    .user-area {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .avatar {
      width: 34px; height: 34px; border-radius: 50%;
      background: #15385E; color: white;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 700;
    }
    .user-name { font-size: 13px; color: #2C3E50; font-weight: 500; }
    .logout { color: #9BA8B4; display: flex; align-items: center; }
    main {
      max-width: 1000px;
      margin: 0 auto;
      padding: 48px 32px;
    }
    h1 { font-size: 26px; color: #15385E; font-weight: 700; margin-bottom: 6px; }
    .subtitle { font-size: 14px; color: #6b7280; margin-bottom: 36px; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 20px;
    }
    .card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 24px;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
      transition: box-shadow 0.15s ease, transform 0.15s ease;
    }
    .card.active:hover {
      box-shadow: 0 4px 16px rgba(21,56,94,0.12);
      transform: translateY(-2px);
    }
    .card.disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }
    .icon-wrap {
      width: 44px; height: 44px;
      background: #EAF1F8;
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
    }
    .card.disabled .icon-wrap { background: #F3F4F6; }
    .card-name { font-size: 16px; font-weight: 600; color: #15385E; }
    .card-desc { font-size: 13px; color: #6b7280; line-height: 1.5; }
    .badge {
      align-self: flex-start;
      font-size: 11px;
      font-weight: 600;
      padding: 3px 10px;
      border-radius: 99px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .badge.active { background: #DCFCE7; color: #166534; }
    .badge.coming_soon { background: #F3F4F6; color: #6b7280; }
  </style>
</head>
<body>
  <header>
    <div class="brand">IWF<span>+</span></div>
    <div class="user-area">
      <div class="avatar"><%= current_user.full_name&.first&.upcase %></div>
      <span class="user-name"><%= current_user.full_name %></span>
      <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "logout", title: "Cerrar sesión" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
      <% end %>
    </div>
  </header>

  <main>
    <h1>Bienvenido, <%= current_user.full_name&.split&.first %></h1>
    <p class="subtitle">Selecciona una aplicación para continuar</p>

    <div class="grid">
      <% @apps.each do |app| %>
        <% if app[:status] == :active %>
          <%= link_to app[:path], class: "card active" do %>
            <div class="icon-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="#15385E" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= app[:icon] %>"/>
              </svg>
            </div>
            <span class="badge active">Activo</span>
            <span class="card-name"><%= app[:name] %></span>
            <span class="card-desc"><%= app[:description] %></span>
          <% end %>
        <% else %>
          <div class="card disabled">
            <div class="icon-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="#9ca3af" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= app[:icon] %>"/>
              </svg>
            </div>
            <span class="badge coming_soon">Próximamente</span>
            <span class="card-name"><%= app[:name] %></span>
            <span class="card-desc"><%= app[:description] %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  </main>
</body>
</html>