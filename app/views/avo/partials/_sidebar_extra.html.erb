  is_dashboard = request.path == "/avo" || request.path == "/avo/"
%>

<%= link_to "/avo",
    "aria-current": (is_dashboard ? "page" : nil),
    class: "iwf-dashboard-link flex items-center" do %>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
  </svg>
  Dashboard
<% end %>

<% nav_groups.each do |group| %>
  <div data-controller="menu"
       data-menu-target="self"
       data-menu-key-param="grupo-<%= group[:key] %>"
       data-menu-default-collapsed-state="expanded">

    <div class="flex justify-between items-center cursor-pointer rounded-lg mx-2 px-2 py-2"
         data-action="click->menu#triggerCollapse"
         data-menu-key-param="grupo-<%= group[:key] %>">
      <div class="flex items-center text-xs uppercase font-semibold tracking-wider" style="white-space:nowrap; overflow:hidden;">
        <%= group[:icon].html_safe %>
        <%= group[:label] %>
      </div>
      <div data-menu-target="svg" style="flex-shrink:0; margin-left:4px;">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </div>
    </div>

    <div data-menu-target="items">
      <% group[:links].each do |link| %>
        <% next if link[:admin_only] && !current_user&.admin? && !current_user&.super_admin? %>
        <%
          is_active = request.path == link[:path] ||
                      request.path.start_with?(link[:path] + "/")
        %>
        <%= link_to link[:path],
            aria: { current: (is_active ? "page" : nil) },
            class: "flex items-center" do %>
          <%= link[:icon].html_safe %>
          <%= link[:label] %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>