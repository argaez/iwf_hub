<%# IWF Hub — Avo custom head %>
<link rel="stylesheet" href="/assets/avo_custom.css">
<script src="/assets/avo_custom.js" defer></script>

<%= content_tag :div, class: "fixed bg-white p-2 w-full flex flex-shrink-0 items-center z-[100] px-4 border-b h-16 print:hidden" do %>
  <div class="flex items-center space-x-2 w-auto lg:w-64 flex-shrink-0 h-full">
    <%= render partial: "avo/partials/logo" %>
  </div>

  <div class="flex-1"></div>

  <div style="display:flex; align-items:center; gap:16px; flex-shrink:0;">
    <span style="font-size:16px; font-weight:800; color:#15385E; letter-spacing:-0.3px; line-height:1;">
      IWF<span style="color:#EF6B35; font-size:24px; font-weight:900;">+</span>
    </span>
    <div style="width:1px; height:22px; background:#E0E6ED;"></div>
    <% if current_user.present? %>
      <div style="display:flex; align-items:center; gap:10px;">
        <div style="width:32px; height:32px; border-radius:50%; background:#15385E; display:flex; align-items:center; justify-content:center; color:white; font-size:13px; font-weight:700; flex-shrink:0;">
          <%= current_user.full_name&.first&.upcase %>
        </div>
        <span style="font-size:13px; color:#2C3E50; font-weight:500;">
          <%= current_user.full_name %>
        </span>
        <%= link_to main_app.destroy_user_session_path,
            data: { turbo_method: :delete },
            title: "Cerrar sesión",
            style: "color:#9BA8B4; display:flex; align-items:center;" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>