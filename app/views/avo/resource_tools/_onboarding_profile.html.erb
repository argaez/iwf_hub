<%
  user = @record
  requests = ActsAsTenant.without_tenant {
    OnboardingRequest.where(user_id: user.id).order(request_date: :desc)
  }
%>

<div style="margin-top:16px;">
  <div style="background:#15385E;color:white;padding:10px 16px;border-radius:8px 8px 0 0;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;">
    Onboarding History
  </div>

  <div style="border:1px solid #E5E7EB;border-top:none;border-radius:0 0 8px 8px;overflow:hidden;">
    <% if requests.any? %>
      <% requests.each do |ob| %>
        <div style="padding:16px;border-bottom:1px solid #F3F4F6;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
            <p style="font-size:13px;font-weight:700;color:#15385E;margin:0;">
              Onboarding — <%= ob.request_date&.strftime("%B %d, %Y") %>
            </p>
            <% if ob.pdf_document.attached? %>
              <%= link_to "Download PDF",
                main_app.rails_blob_path(ob.pdf_document, disposition: "attachment"),
                style: "font-size:12px;color:#15385E;font-weight:600;text-decoration:none;background:#EAF1F8;padding:4px 12px;border-radius:99px;" %>
            <% end %>
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:12px;">
            <div>
              <span style="color:#6B7280;">Start Date:</span>
              <span style="color:#111827;font-weight:500;margin-left:4px;"><%= ob.start_date&.strftime("%b %d, %Y") || "—" %></span>
            </div>
            <div>
              <span style="color:#6B7280;">New Computer:</span>
              <span style="color:#111827;font-weight:500;margin-left:4px;"><%= ob.new_computer? ? "Yes" : "No" %></span>
            </div>
            <div>
              <span style="color:#6B7280;">Remote Access:</span>
              <span style="color:#111827;font-weight:500;margin-left:4px;"><%= ob.remote_access_needed? ? "Yes" : "No" %></span>
            </div>
            <div>
              <span style="color:#6B7280;">Extension:</span>
              <span style="color:#111827;font-weight:500;margin-left:4px;"><%= ob.extension&.number || "—" %></span>
            </div>
          </div>

          <% if ob.applications.present? && ob.applications.any? %>
            <div style="margin-top:8px;">
              <span style="font-size:12px;color:#6B7280;">Applications:</span>
              <span style="font-size:12px;color:#111827;font-weight:500;margin-left:4px;"><%= ob.applications.join(", ") %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p style="font-size:13px;color:#9CA3AF;text-align:center;padding:20px;">No onboarding requests found.</p>
    <% end %>
  </div>
</div>