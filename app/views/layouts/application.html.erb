<!DOCTYPE html>
<html>
  <head>
    <title>IWF Hub</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
  </head>
  <body>
    <%= content_tag :p, notice, class: "notice" if notice.present? %>
    <%= content_tag :p, alert, class: "alert" if alert.present? %>
    <%= yield %>
  </body>
</html>